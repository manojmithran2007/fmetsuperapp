# ==============================================================================
# COLLEGE BUS MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. SUPABASE_URL: Found in Supabase Dashboard -> Project Settings -> API -> Project URL
#    Access Level: Public (Used by both backend and client)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. SUPABASE_ANON_KEY: Found in Supabase Dashboard -> Project Settings -> API -> anon public
#    Access Level: Public (Used by frontend client and non-privileged backend requests)
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 3. SUPABASE_SERVICE_ROLE_KEY: Found in Supabase Dashboard -> Project Settings -> API -> service_role
#    Access Level: SERVER-ONLY SECRET (NEVER expose to browser/client-side code or Git!)
#    Used strictly on the Node.js backend for administrative user creation and verification.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret
